    "@vue/test-utils": "^2.4.6",
    "execa": "^9.6.1",
    "jsdom": "^26.1.0",
    "prisma": "^7.2.0",
    "sass": "^1.97.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
