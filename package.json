{
  "name": "virify",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate --config=./layers/database/server/database/prisma/prisma.config.ts && pnpm run pgen:ppd && pnpm run pgen:waiting-list && nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "pgen": "prisma generate --config=./layers/database/server/database/prisma/prisma.config.ts",
    "pgen:ppd": "prisma generate --config=./layers/database/server/database/prisma-ppd/prisma.config.ts",
    "pgen:waiting-list": "prisma generate --config=./layers/database/server/database/prisma-waiting-list/prisma.config.ts",
    "migrate-reset": "prisma migrate reset",
    "migrate-reset:ppd": "prisma migrate reset --config=./layers/database/server/database/prisma-ppd/prisma.config.ts",
    "migrate-reset:waiting-list": "prisma migrate reset --config=./layers/database/server/database/prisma-waiting-list/prisma.config.ts",
    "db:migrate-dev": "prisma migrate dev --config=./layers/database/server/database/prisma/prisma.config.ts",
    "db:migrate-deploy": "prisma migrate deploy --config=./layers/database/server/database/prisma/prisma.config.ts",
    "db:migrate-dev:ppd": "prisma migrate dev --config=./layers/database/server/database/prisma-ppd/prisma.config.ts",
    "migrate-dev:waiting-list": "prisma migrate dev --config=./layers/database/server/database/prisma-waiting-list/prisma.config.ts",
    "db-push": "prisma db push --config=./layers/database/server/database/prisma/prisma.config.ts",
    "db-push:ppd": "prisma db push --config=./layers/database/server/database/prisma-ppd/prisma.config.ts",
    "db-studio": "prisma studio --config=./layers/database/server/database/prisma/prisma.config.ts",
    "db-studio:ppd": "prisma studio --config=./layers/database/server/database/prisma-ppd/prisma.config.ts",
    "db-studio:waiting-list": "prisma studio --config=./layers/database/server/database/prisma-waiting-list/prisma.config.ts",
    "prisma-format": "prisma format --config=./layers/database/server/database/prisma/prisma.config.ts",
    "prisma-validate": "prisma validate --config=./layers/database/server/database/prisma/prisma.config.ts",
    "db:reset": "tsx layers/seed/server/utils/run-reset.ts",
    "db:seed:base": "tsx layers/seed/server/utils/run-seed-base.ts",
    "db:seed:full": "tsx layers/seed/server/utils/run-seed-full.ts",
    "db:migrate": "tsx layers/seed/server/utils/run-migrate.ts",
    "db:setup": "tsx layers/seed/server/utils/run-setup.ts",
    "db:setup:prod": "tsx layers/seed/server/utils/run-setup.ts --prod",
    "db:fetch-rates": "tsx layers/seed/server/utils/run-fetch-rates.ts",
    "db:update-admin-password": "tsx layers/seed/server/utils/run-admin-update.ts",
    "seed:address": "tsx layers/seed/server/utils/extract-and-geocode-addresses.ts",
    "test": "vitest run",
    "test:full": "vitest run",
    "start": "node .output/server/index.mjs"
  },
  "prisma": {
    "schema": "./layers/database/server/database/prisma/"
  },
