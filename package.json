{
  "name": "virify",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && pnpm run pgen:ppd && nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "pgen": "prisma generate",
    "pgen:ppd": "prisma generate --schema=layers/database/server/database/prisma-ppd/schema.prisma",
    "migrate-reset": "prisma migrate reset",
    "migrate-reset:ppd": "prisma migrate reset --schema=layers/database/server/database/prisma-ppd/schema.prisma",
    "migrate-dev": "prisma migrate dev",
    "migrate-dev:ppd": "prisma migrate reset --schema=layers/database/server/database/prisma-ppd/schema.prisma",
    "db-push": "prisma db push",
    "db-push:ppd": "prisma db push --schema=./layers/database/server/database/prisma-ppd/schema.prisma",
    "db-studio:ppd": "prisma studio --schema=./layers/database/server/database/prisma-ppd/schema.prisma",
    "db:reset": "tsx layers/seed/scripts/reset.ts",
    "db:seed": "tsx layers/seed/scripts/seed.ts",
    "db:migrate": "tsx layers/seed/scripts/migrate.ts",
    "test": "vitest run",
    "test:full": "vitest run",
    "start": "node .output/server/index.mjs"
  },
  "prisma": {
    "schema": "./layers/database/server/database/prisma/"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.799.0",
    "@mapbox/mapbox-gl-draw": "^1.5.0",
    "@maptiler/sdk": "^3.2.2",
    "@nuxt/image": "1.10.0",
    "@nuxtjs/fontaine": "0.5.0",
    "@prisma/nuxt": "^0.3.0",
    "@turf/turf": "^7.2.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue-email/components": "^0.0.21",
    "@vue-email/render": "^0.0.9",
    "@vueuse/core": "^13.1.0",
    "auth-utils": "^1.0.0",
    "dotenv": "^17.2.1",
    "embla-carousel-vue": "^8.6.0",
    "g": "^2.0.1",
    "maptiler-sdk.css": "link:@maptiler/sdk/dist/maptiler-sdk.css",
    "node-fetch": "^3.3.2",
    "nuxi": "^3.25.0",
    "nuxt": "^4.0.0",
    "nuxt-auth-utils": "^0.5.20",
    "nuxt-gtag": "3.0.2",
    "openai": "^5.6.0",
    "pg": "^8.15.6",
    "pg-copy-streams": "^7.0.0",
    "reka-ui": "^2.2.0",
    "vue": "latest",
    "vue-router": "^4.5.1",
    "zod": "^4.0.5"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "devDependencies": {
    "@faker-js/faker": "^9.7.0",
    "@nuxt/test-utils": "^3.17.2",
    "@prisma/client": "^6.12.0",
    "@types/mapbox__mapbox-gl-draw": "^1.4.8",
    "@types/pg": "^8.11.14",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "prisma": "^6.12.0",
    "sass": "^1.87.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
