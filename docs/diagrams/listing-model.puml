@startuml
' Full UML for Listing and related models (generated from Prisma schema)

skinparam classAttributeIconSize 0

' Listing and related models
class Listing {
  +id : Int
  +title : String
  +description : String
  +price : Float
  +moveInDate : DateTime?
  +listingTier : ListingTier
  +listingStartDate : DateTime?
  +listingEndDate : DateTime?
  +viewingOptions : String?
  +verificationLevel : VerificationLevel?
  +rentalListing : RentalListing?
  +saleListing : SaleListing?
  +userId : Int?
  +propertyId : Int
  +estateAgentId : Int?
  +publishedAt : DateTime?
  +published : Boolean
  +createdAt : DateTime
  +updatedAt : DateTime
}

class User {
  +id : Int
  +firstName : String?
  +lastName : String?
  +username : String?
  +email : String
  +phoneNumber : String?
  +password : String?
  +passwordResetToken : String?
  +passwordResetTokenExpiry : DateTime?
  +otpCode : String?
  +otpCodeExpiry : DateTime?
  +lastLogin : DateTime?
  +deletedAt : DateTime?
  +createdAt : DateTime
  +updatedAt : DateTime
}

class Property {
  +id : Int
  +title : String
  +description : String
  +value : Float?
  +size : Float?
  +yearBuilt : String?
  +chainFree : Boolean
  +vacant : Boolean
  +constructionType : String?
  +floorLevel : Int?
  +totalFloors : Int
  +numberBedrooms : Int?
  +numberBathrooms : Int?
  +numberReceptions : Int?
  +numberOtherRooms : Int?
  +createdAt : DateTime
  +updatedAt : DateTime
}



class RentalListing {
  +id : Int
  +deposit : Float?
  +holdingDeposit : Float?
  +rentFrequency : RentalPriceType
  +isBillsIncluded : Boolean
  +rentalLength : Int?
  +furnishedStatus : FurnishedStatus?
  +availabilityStatus : RentalAvailabilityStatus
}

class SaleListing {
  +id : Int
  +tenureType : TenureType?
  +chain : Boolean
  +sharedOwnership : Boolean
  +priceType : SalePriceType
  +availabilityStatus : SaleAvailabilityStatus
}


class Address {
  +id : Int
  +number : String?
  +flat : String?
  +street : String
  +city : String
  +postcode : String
  +country : String?
  +county : String?
  +fullAddress : String?
  +lat : Float?
  +lon : Float?
  +createdAt : DateTime
  +updatedAt : DateTime
}

class Media {
  +id : Int
  +image : String?
  +videoTour : String?
  +floorPlan : String?
  +metadata : String
  +propertyId : Int
  +createdAt : DateTime
  +updatedAt : DateTime
}

' Property-related models (expanded)
class Amenities {
  +id : Int
  +type : AmenityType
  +subtype : AmenitySubtype?
  +name : String
  +distanceM : Float
  +description : String?
  +propertyId : Int
}

class Bedroom {
  +id : Int
  +roomNumber : Int
  +name : String?
  +bed : BedSizeType[]
  +floor : Int
  +size : Float?
  +propertyId : Int
}

class Bathroom {
  +id : Int
  +roomNumber : Int
  +floor : Int
  +name : String?
  +bathtub : Boolean
  +walkInShower : Boolean
  +size : Float?
  +propertyId : Int
}

class Kitchen {
  +id : Int
  +modern : Boolean
  +openPlan : Boolean
  +whiteGoods : Boolean
  +size : Float?
  +propertyId : Int
}

class Reception {
  +id : Int
  +roomNumber : Int
  +floor : Int
  +name : String
  +type : ReceptionType
  +size : Float?
  +propertyId : Int
}

class OtherRoom {
  +id : Int
  +roomNumber : Int
  +floor : Int
  +name : String
  +type : OtherRoomType
  +size : Float?
  +propertyId : Int
}

class FrontGarden {
  +id : Int
  +description : String?
  +size : Float?
  +propertyId : Int
}

class RearGarden {
  +id : Int
  +description : String?
  +size : Float?
  +propertyId : Int
}

class Parking {
  +id : Int
  +garage : Boolean
  +driveway : Boolean
  +allocatedParking : Boolean
  +evCharging : Boolean
  +propertyId : Int
}

class Security {
  +id : Int
  +description : String?
  +gatedCommunity : Boolean
  +cctv : Boolean
  +alarmSystem : Boolean
  +propertyId : Int
}

class EnergyAndUtilities {
  +id : Int
  +epcRating : EPCRating
  +broadbandType : BroadbandType?
  +fullFibreAvailable : Boolean
  +maxDownloadSpeedMbps : Float?
  +propertyId : Int
}

class RunningCosts {
  +id : Int
  +councilTaxBand : String
  +serviceCharges : Float?
  +groundRent : Float?
  +propertyId : Int
}

' ' Enums omitted for clarity (to avoid PlantUML syntax issues)

' Relations

' Listing -> User (optional many-to-one)
User "1" <-- "0..*" Listing : user

' Listing -> Property (required many-to-one, onDelete: Cascade)
Property "1" <-- "1..*" Listing : property

' Property -> Address (required many-to-one, onDelete: Cascade)
Address "1" <-- "1..*" Property : address

' Listing <-> Agent (many-to-many via relation name AgentToListing)

' ' Engagement/analytics and messaging relations removed from this UML

' Listing -> RentalListing (one-to-one)
Listing "1" <-- "0..1" RentalListing : rentalListing

' Listing -> SaleListing (one-to-one)
Listing "1" <-- "0..1" SaleListing : saleListing

' Property -> property-detail relations (from Prisma schema)
Property "1" <-- "0..*" Amenities : Amenities.property
Property "1" <-- "0..*" Bedroom : Bedroom.property
Property "1" <-- "0..*" Bathroom : Bathroom.property
Property "1" <-- "0..*" Reception : Reception.property
Property "1" <-- "0..*" OtherRoom : OtherRoom.property
Property "1" <-- "0..1" Kitchen : Kitchen.property
Property "1" <-- "0..1" FrontGarden : FrontGarden.property
Property "1" <-- "0..1" RearGarden : RearGarden.property
Property "1" <-- "0..1" Parking : Parking.property
Property "1" <-- "0..1" Security : Security.property
Property "1" <-- "0..1" EnergyAndUtilities : EnergyAndUtilities.property
Property "1" <-- "0..1" RunningCosts : RunningCosts.property
Property "1" <-- "0..*" Media : Media.property

' Additional relations (to show context but not exhaustive cross-linking)

@enduml
