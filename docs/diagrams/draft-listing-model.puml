@startuml
' DraftListing design proposal (mirror of Listing model with isDraft)

skinparam classAttributeIconSize 0

' Enums
enum ListingTier {
  BASIC
  PREMIUM
  FEATURED
}

enum VerificationLevel {
  UNVERIFIED
  BASIC
  VERIFIED
  FULLY_VERIFIED
}

enum FurnishedStatus {
  FURNISHED
  UNFURNISHED
  PART_FURNISHED
}

enum RentalPriceType {
  WEEKLY
  MONTHLY
}

enum RentalAvailabilityStatus {
  AVAILABLE
  LET_AGREED
  LET
}

enum TenureType {
  FREEHOLD
  LEASEHOLD
  COMMONHOLD
}

enum SalePriceType {
  FIXED
  OFFERS_OVER
  GUIDE_PRICE
}

enum SaleAvailabilityStatus {
  AVAILABLE
  UNDER_OFFER
  SOLD
}

enum AgentRole {
  SENIOR
  JUNIOR
}

enum Reviewed {
  PENDING
  APPROVED
  REJECTED
}

' DraftListing and related models (mirrors Listing file)
class DraftListing {
  +id : Int
  +title : String
  +description : String
  +price : Float
  +moveInDate : DateTime?
  +listingTier : ListingTier
  +listingStartDate : DateTime?
  +listingEndDate : DateTime?
  +viewingOptions : String?
  +verificationLevel : VerificationLevel?
  +rentalListing : RentalListing?
  +saleListing : SaleListing?
  +userId : Int?
  +propertyId : Int
  +estateAgentId : Int?
  +publishedAt : DateTime?
  +isDraft : Boolean
  +createdAt : DateTime
  +updatedAt : DateTime
}

class User {
  +id : Int
  +firstName : String?
  +lastName : String?
  +username : String?
  +email : String
  +phoneNumber : String?
  +password : String?
  +passwordResetToken : String?
  +passwordResetTokenExpiry : DateTime?
  +otpCode : String?
  +otpCodeExpiry : DateTime?
  +lastLogin : DateTime?
  +deletedAt : DateTime?
  +createdAt : DateTime
  +updatedAt : DateTime
}

class Property {
  +id : Int
  +title : String
  +description : String
  +value : Float?
  +size : Float?
  +yearBuilt : String?
  +chainFree : Boolean
  +vacant : Boolean
  +constructionType : String?
  +floorLevel : Int?
  +totalFloors : Int
  +numberBedrooms : Int?
  +numberBathrooms : Int?
  +numberReceptions : Int?
  +numberOtherRooms : Int?
  +createdAt : DateTime
  +updatedAt : DateTime
}

class EstateAgent {
  +id : Int
  +firstName : String?
  +lastName : String?
  +email : String
  +mainContact : String?
  +phoneNumber : String?
  +password : String?
  +businessName : String?
  +companyRegistration : String?
  +passwordResetToken : String?
  +passwordResetTokenExpiry : DateTime?
  +otpCode : String?
  +otpCodeExpiry : DateTime?
  +lastLogin : DateTime?
  +deletedAt : DateTime?
  +createdAt : DateTime
  +updatedAt : DateTime
}

class Agent {
  +id : Int
  +firstName : String?
  +lastName : String?
  +email : String
  +password : String?
  +estateAgentId : Int
  +role : AgentRole
  +passwordResetToken : String?
  +lastLogin : DateTime?
  +activationToken : String?
  +tokenExpiry : DateTime?
  +isActivated : Boolean
  +createdAt : DateTime
  +updatedAt : DateTime
  +deletedAt : DateTime?
}

class HiddenListing {
  +id : Int
  +userPreferencesId : Int
  +listingId : Int
  +reason : String?
  +hiddenAt : DateTime
}

class UserFavouriteListing {
  +id : Int
  +userPreferencesId : Int
  +listingId : Int
  +note : String?
  +createdAt : DateTime
  +updatedAt : DateTime
}

class ListingView {
  +id : Int
  +listingId : Int
  +userId : Int?
  +sessionId : String?
  +ip : String?
  +createdAt : DateTime
}

class Conversation {
  +id : Int
  +listingId : Int?
  +senderId : Int
  +receiverId : Int
  +createdAt : DateTime
  +updatedAt : DateTime
}

class UserNote {
  +id : Int
  +userPreferencesId : Int
  +listingId : Int
  +note : String
  +createdAt : DateTime
  +updatedAt : DateTime
}

class RentalListing {
  +id : Int
  +deposit : Float?
  +holdingDeposit : Float?
  +rentFrequency : RentalPriceType
  +isBillsIncluded : Boolean
  +rentalLength : Int?
  +furnishedStatus : FurnishedStatus?
  +availabilityStatus : RentalAvailabilityStatus
}

class SaleListing {
  +id : Int
  +tenureType : TenureType?
  +chain : Boolean
  +sharedOwnership : Boolean
  +priceType : SalePriceType
  +availabilityStatus : SaleAvailabilityStatus
}

class UserPreferences {
  +id : Int
  +userId : Int
  +createdAt : DateTime
  +updatedAt : DateTime
}

class Message {
  +id : Int
  +senderId : Int
  +receiverId : Int
  +conversationId : Int
  +content : String
  +isRead : Boolean
  +createdAt : DateTime
  +updatedAt : DateTime
}

class Address {
  +id : Int
  +number : String?
  +flat : String?
  +street : String
  +city : String
  +postcode : String
  +country : String?
  +county : String?
  +fullAddress : String?
  +lat : Float?
  +lon : Float?
  +createdAt : DateTime
  +updatedAt : DateTime
}

class Media {
  +id : Int
  +image : String?
  +videoTour : String?
  +floorPlan : String?
  +metadata : String
  +propertyId : Int
  +createdAt : DateTime
  +updatedAt : DateTime
}

' Relations

' DraftListing -> User (optional many-to-one)
User "1" <-- "0..*" DraftListing : user

' DraftListing -> Property (required many-to-one, onDelete: Cascade)
Property "1" <-- "1..*" DraftListing : property

' DraftListing -> EstateAgent (optional many-to-one)
EstateAgent "1" <-- "0..*" DraftListing : estateAgent

' DraftListing <-> Agent (many-to-many via relation name AgentToListing)
Agent "0..*" <-- "0..*" DraftListing : AgentToListing

' DraftListing -> HiddenListing (one-to-many)
DraftListing "1" <-- "0..*" HiddenListing : HiddenListing.listing

' DraftListing -> UserFavouriteListing (one-to-many)
DraftListing "1" <-- "0..*" UserFavouriteListing : UserFavouriteListing.listing

' DraftListing -> ListingView (one-to-many)
DraftListing "1" <-- "0..*" ListingView : ListingView.listing

' DraftListing -> Conversation (one-to-many)
DraftListing "1" <-- "0..*" Conversation : Conversation.listing

' DraftListing -> UserNote (one-to-many)
DraftListing "1" <-- "0..*" UserNote : UserNote.listing

' DraftListing -> RentalListing (one-to-one)
DraftListing "1" <-- "0..1" RentalListing : rentalListing

' DraftListing -> SaleListing (one-to-one)
DraftListing "1" <-- "0..1" SaleListing : saleListing

' Additional relations (to show context but not exhaustive cross-linking)
User "1" <-- "0..*" ListingView : ListingView.user
User "1" <-- "0..*" Message : Message.sender
User "1" <-- "0..*" Message : Message.receiver
Conversation "1" <-- "0..*" Message : Conversation.messages
UserPreferences "1" <-- "0..*" UserFavouriteListing : UserFavouriteListing.userPreferences
UserPreferences "1" <-- "0..*" HiddenListing : HiddenListing.userPreferences
UserPreferences "1" <-- "0..*" UserNote : UserNote.userPreferences

@enduml
