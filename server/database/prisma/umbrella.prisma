model Umbrella {
  id                  Int      @id @default(autoincrement())
  name                String
  businessName        String
  addressLine1        String
  addressLine2        String?
  city                String
  county              String?
  postcode            String
  country             String
  companyRegistration String   @unique
  owners              Owner[]
  verified            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
