model Diningroom {
  id          Int      @id @default(autoincrement())
  roomNumber  Int      @default(1)
  openConcept Boolean
  description String
  propertyId  Int
  size        Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  property    Property @relation(fields: [propertyId], references: [id])
}
