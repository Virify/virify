model User {
  id                Int                @id @default(autoincrement())
  firstName         String?
  lastName          String?
  username          String?            @unique
  email             String             @unique
  password          String?
  verified          verificationStatus @default(NO)
  addressLine1      String?
  addressLine2      String?
  city              String?
  county            String?
  postcode          String?
  country           String?
  agentId           Int?
  agent             Agent?             @relation(fields: [agentId], references: [id])
  property          Property[]
  listings          Listing[]
  role              Role               @default(USER)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  activationToken   String?
  activationExpires DateTime?
  isActivated       Boolean            @default(false)
}

enum verificationStatus {
  PENDING
  VERIFIED
  NO
}

enum Role {
  USER
  AGENT
  OWNER
  JUNIOR_AGENT
  SENIOR_AGENT
  MANAGER
}
