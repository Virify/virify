model Agent {
  id                   Int        @id @default(autoincrement())
  email                String     @unique
  password             String
  name                 String     @unique
  contactInfo          String
  directContactOptions String?
  viewingAvailability  String?
  addressLine1         String
  addressLine2         String?
  city                 String
  county               String
  postcode             String
  country              String
  companyRegistration  String     @unique
  users                User[]
  addressId            Int?
  property             Property[]
  Listing              Listing[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
}
