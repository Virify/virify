model Agent {
  id                 Int        @id @default(autoincrement())
  firstName          String?
  lastName           String?
  email              String     @unique
  password           String?
  owner              Owner      @relation(fields: [ownerId], references: [id])
  ownerId            Int
  role               AgentRole @default(SENIOR)
  properties         Property[]
  listings           Listing[]
  passwordResetToken String?
  lastLogin          DateTime?
  activationToken    String?
  tokenExpiry        DateTime?
  isActivated        Boolean    @default(false)

  @@index([ownerId])
}

enum AgentRole {
  SENIOR
  JUNIOR
}
