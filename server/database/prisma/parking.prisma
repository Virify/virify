model Parking {
  id            Int      @id @default(autoincrement())
  garage        Boolean
  driveway      Boolean
  permitParking Boolean
  onStreet      Boolean
  noParking     Boolean
  description   String
  propertyId    Int      @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  property      Property @relation(fields: [propertyId], references: [id])
}
