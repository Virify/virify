model Amenities {
  id             Int      @id @default(autoincrement())
  transportLinks String?
  schools        String?
  hospitals      String?
  shopping       String?
  greenSpaces    String?
  description    String?
  propertyId     Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  property       Property @relation(fields: [propertyId], references: [id])
}
