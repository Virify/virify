model Property {
  id                     Int                    @id @default(autoincrement())
  propertyValue          Float?
  propertyType           PropertyType
  propertyClassification PropertyClassification
  size                   Float?
  yearBuilt              String
  constructionType       ConstructionType
  roofConstruction       RoofConstruction
  floorLevel             Int?
  furnishingStatus       FurnishingStatus
  tenure                 Tenure
  leaseTerm              Int?
  address                Address?               @relation(fields: [addressId], references: [id])
  addressId              Int?                   @unique
  bedrooms               Int                    @default(3)
  bathrooms              Int                    @default(1)
  kitchens               Int                    @default(1)
  livingRooms            Int                    @default(1)
  diningRooms            Int                    @default(1)
  bedroomFeatures        BedroomFeatures[]
  diningroomFeatures     DiningroomFeatures[]
  kitchenFeatures        KitchenFeatures?
  livingAreaFeatures     LivingAreaFeatures[]
  bathroomFeatures       BathroomFeatures[]
  storageFeatures        StorageFeatures?
  outdoorSpace           OutdoorSpace?
  parking                Parking?
  securityFeatures       SecurityFeatures?
  amenities              AmenitiesFeature[]
  runningCosts           RunningCosts?
  media                  Media[]
  owner                  Owner?                 @relation(fields: [ownerId], references: [id])
  ownerId                Int?
  agents                 Agent[]
  additionalFeatures     AdditionalFeatures[]
  listing                Listing?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([ownerId])
}

enum PropertyType {
  HOUSE
  COTTAGE
  BUNGALOW
  CONDO
  PENTHOUSE
  FLAT
  LAND
  NEW_BUILD
  SHARED_OWNERSHIP
  RETIREMENT
  STUDENT
}

enum PropertyClassification {
  SEMI_DETACHED
  END_OF_TERRACE
  DETACHED
  TERRACED
  NON_WORKING_FARM
  WORKING_FARM
}

enum ConstructionType {
  STONE
  BRICK
  STANDARD
}

enum RoofConstruction {
  SLATE_TILE
  CONCRETE_TILE
}

enum FurnishingStatus {
  FURNISHED
  UNFURNISHED
  PART_FURNISHED
}

enum Tenure {
  LEASEHOLD
  FREEHOLD
}
