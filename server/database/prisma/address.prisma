model Address {
  id         Int                                   @id @default(autoincrement())
  number     String?
  street     String?
  city       String?
  postcode   String?
  country    String?
  propertyId Int?                                  @unique
  createdAt  DateTime                              @default(now())
  updatedAt  DateTime                              @updatedAt
  location   Unsupported("geometry(Point, 4326)")?
  property   Property?

  // index for location and spacial queries
  @@index([location], map: "address_location_idx", type: Gist)
  
  // index for full text search
  @@index([postcode], map: "address_postcode_idx")
  @@index([city], map: "address_city_idx")
  @@index([street], map: "address_street_idx")
}
