// This file contains WaitingList model only. Connection/generator configured in `prisma.config.ts`.

datasource waitingListDb {
  provider = "postgresql"
}

generator client {
  provider      = "prisma-client"
  output        = "./generated/"
}

model WaitingList {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
