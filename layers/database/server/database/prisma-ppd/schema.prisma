// This file is a Prisma schema fragment for the PPD models.
// The datasource name is preserved so this model can be used with a separate database.
datasource ppdDb {
  provider = "postgresql"
}

generator client {
  provider      = "prisma-client"
  output        = "./generated/"
}

model PricePaid {
  transaction_id String @id
  price Int
  transfer_date DateTime
  postcode String?
  property_type String?
  old_new String?
  duration String?
  paon String?
  saon String?
  street String?
  locality String?
  town_city String?
  district String?
  county String?
  ppd_category String?
  record_status String?
  @@index([postcode])
  @@index([postcode, paon, street, town_city, county])
  @@index([transfer_date])
  @@index([price])
  @@map("price_paid")
}
