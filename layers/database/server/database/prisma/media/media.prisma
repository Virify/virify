model Media {
  id         Int      @id @default(autoincrement())
  image      String?
  videoTour  String?
  floorPlan  String?
  metadata   String
  propertyId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
}
