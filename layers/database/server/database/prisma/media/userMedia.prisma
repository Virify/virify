enum UserMediaType {
  IMAGE
  PDF
  DOCUMENT
  SPREADSHEET
  OTHER
}

model UserMedia {
  id           Int           @id @default(autoincrement())
  userId       Int
  key          String        @unique
  mediaType    UserMediaType
  mimeType     String
  originalName String
  size         Int
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([userId])
}
