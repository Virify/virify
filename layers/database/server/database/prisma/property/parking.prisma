model Parking {
  id               Int      @id @default(autoincrement())
  description      String?
  garage           Boolean  @default(false)
  driveway         Boolean  @default(false)
  permitParking    Boolean  @default(false)
  onStreet         Boolean  @default(false)
  noParking        Boolean  @default(false)
  carport          Boolean  @default(false)
  allocatedParking Boolean  @default(false)
  evCharging       Boolean  @default(false)
  propertyId       Int      @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}
