model Property {
  id                    Int                    @id @default(autoincrement())
  title                 String
  description           String
  value                 Float?
  type                  PropertyType
  classification        PropertyClassification
  size                  Float?
  yearBuilt             String
  constructionType      ConstructionType
  roofConstruction      RoofConstruction
  floorLevel            Int?
  furnishingStatus      FurnishingStatus
  tenure                Tenure
  leaseTerm             Int?
  addressId             Int?                   @unique
  userId                Int?
  agentId               Int?
  // features
  additionalFeatures    AdditionalFeatures?
  accessibilityFeatures Accessibility?
  amenities             Amenities[]
  bathroomFeatures      Bathroom[]
  bedroomFeatures       Bedroom[]
  diningroomFeatures    Diningroom[]
  kitchenFeatures       Kitchen[]
  listing               Listing?
  livingAreaFeatures    LivingArea[]
  media                 Media[]
  outdoorSpace          OutdoorSpace?
  Land                  Land?
  parking               Parking?
  energyAndUtilities    EnergyAndUtilities?
  reception             Reception[]
  utility               Utility[]
  additionalToilet      AdditionalToilet[]
  address               Address?               @relation(fields: [addressId], references: [id])
  user                  User?                  @relation(fields: [userId], references: [id])
  runningCosts          RunningCosts?
  securityFeatures      Security?
  storageFeatures       Storage?
  agents                Agent[]                @relation("AgentToProperty")
  estateAgent           EstateAgent?           @relation(fields: [estateAgentId], references: [id])
  estateAgentId         Int?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([userId])
  @@index([agentId])
}

enum PropertyType {
  HOUSE
  COTTAGE
  BUNGALOW
  PENTHOUSE
  FLAT
  LAND
  FARM
  SHARED_OWNERSHIP
  RETIREMENT_HOME
  NEW_BUILD_HOME
  STUDENT_ACCOMMODATION
}

enum PropertyClassification {
  // Houses
  TERRACED_HOUSE
  SEMI_DETACHED_HOUSE
  END_OF_TERRACE_HOUSE
  DETACHED_HOUSE
  MANSION

  // Cottages
  TERRACED_COTTAGE
  SEMI_DETACHED_COTTAGE
  END_OF_TERRACE_COTTAGE
  DETACHED_COTTAGE

  // Bungalows
  TERRACED_BUNGALOW
  SEMI_DETACHED_BUNGALOW
  END_OF_TERRACE_BUNGALOW
  DETACHED_BUNGALOW

  // Flats
  PENTHOUSE
  CONVERTED_FLAT
  STUDIO_FLAT
  MAISONETTE
  HIGH_RISE_FLAT
  COMPLEX_FLAT

  // Land
  RESIDENTIAL_LAND
  COMMERCIAL_LAND
  AGRICULTURAL_LAND
  DEVELOPMENT_PLOT

  // Farms
  NON_WORKING_FARMHOUSE
  WORKING_FARM

  // Other Categories
  SHARED_OWNERSHIP
  RETIREMENT_HOME
  NEW_BUILD_HOME

  // Student Accommodation
  STUDENT_FLAT
  STUDENT_HOUSE
  STUDENT_HOUSE_SHARE
}

enum ConstructionType {
  STANDARD
  NON_STANDARD
}

enum RoofConstruction {
  SLATE_TILE
  CONCRETE_TILE
}

enum FurnishingStatus {
  FURNISHED
  UNFURNISHED
  PART_FURNISHED
}

enum Tenure {
  LEASEHOLD
  FREEHOLD
}
