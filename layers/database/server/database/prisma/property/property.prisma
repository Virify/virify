model Property {
  id                       Int                    @id @default(autoincrement())
  title                    String
  description              String
  value                    Float?
  size                     Float?
  yearBuilt                String?
  chainFree                Boolean                @default(false)
  vacant                   Boolean                @default(false)
  constructionType         ConstructionType?
  floorLevel               Int?
  totalFloors              Int
  additionalFeatures       AdditionalFeatures?
  accessibilityFeatures    Accessibility?
  amenities                Amenities[]
  numberBedrooms           Int?                   @default(0)
  numberBathrooms          Int?                   @default(0)
  numberReceptions         Int?                   @default(0)
  bathroomFeatures         Bathroom[]
  bedroomFeatures          Bedroom[]
  kitchenFeatures          Kitchen?
  reception                Reception[]
  utility                  Utility?
  listing                  Listing[]
  media                    Media[]
  outdoorSpace             OutdoorSpace?
  parking                  Parking?
  energyAndUtilities       EnergyAndUtilities?
  address                  Address                @relation(fields: [addressId], references: [id], onDelete: Cascade)
  runningCosts             RunningCosts?
  securityFeatures         Security?
  storageFeatures          Storage?
  user                     User?                  @relation(fields: [userId], references: [id])
  agents                   Agent[]                @relation("AgentToProperty")
  estateAgent              EstateAgent?           @relation(fields: [estateAgentId], references: [id])
  type                     PropertyType           @relation(fields: [propertyTypeId], references: [id])
  classification           PropertyClassification @relation(fields: [propertyClassificationId], references: [id])
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  addressId                Int
  userId                   Int?
  estateAgentId            Int?
  propertyTypeId           Int
  propertyClassificationId Int

  @@index(addressId)
}

enum ConstructionType {
  STANDARD
  NON_STANDARD
}
