model Land {
  id                Int           @id @default(autoincrement())
  description       String?
  additionalDetails Boolean       @default(false)
  size              Float?
  name              String
  separateParcel    Boolean       @default(false)
  features          LandFeature[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  media             Media[]
  outdoorSpace      OutdoorSpace? @relation(fields: [outdoorSpaceId], references: [id])
  outdoorSpaceId    Int?

  @@index([outdoorSpaceId])
}

enum LandFeature {
  WOODLAND
  PADDOCK
  STABLES
  TENNIS_COURT
  ORCHARD
  POND
  OUTBUILDING
}
