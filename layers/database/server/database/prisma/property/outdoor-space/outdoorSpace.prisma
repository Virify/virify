model OutdoorSpace {
  id          Int                   @id @default(autoincrement())
  description String?
  totalArea   Float?
  yard        Yard[]
  garden      Garden[]
  land        Land[]
  features    OutdoorSpaceFeature[]
  propertyId  Int                   @unique
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @default(now())
  media       Media[]
  property    Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

enum OutdoorSpaceFeature {
  SUN_TERRACE
  TERRACE
  BALCONY
  PATIO
  SEPARATE_PARCEL
  SHED
  SUMMER_HOUSE
  GARDEN_OFFICE
  POOL
}
