model Bathroom {
  id           Int      @id @default(autoincrement())
  roomNumber   Int
  floor        Int
  name         String?
  toilet       Boolean  @default(false)
  enSuite      Boolean  @default(false)
  bathtub      Boolean  @default(true)
  walkInShower Boolean  @default(false)
  description  String
  size         Float?
  propertyId   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  media        Media[]

  @@index([propertyId])
}
