model AdditionalToilet {
  id             Int      @id @default(autoincrement())
  downstairs     Boolean  @default(false)
  upstairs       Boolean  @default(false)
  guestCloakroom Boolean  @default(false)
  description    String?
  propertyId     Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  property       Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
}
