model OtherRoom {
  id          Int           @id @default(autoincrement())
  roomNumber  Int
  floor       Int
  name        String
  type        OtherRoomType
  description String?
  size        Float?
  features    RoomFeature[]
  propertyId  Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  property    Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  media       Media[]

  @@index([propertyId])
}

enum OtherRoomType {
  OFFICE
  STUDY
  LIBRARY
  GYM
  WORKSHOP
  POOL_ROOM
  WINE_CELLAR
  SPA
  OTHER
}
