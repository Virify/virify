model Security {
  id                Int      @id @default(autoincrement())
  description       String?
  gatedCommunity    Boolean  @default(false)
  cctv              Boolean  @default(false)
  alarmSystem       Boolean  @default(false)
  neighborhoodWatch Boolean  @default(false)
  intercomSystem    Boolean  @default(false)
  security          Boolean  @default(false)
  reception         Boolean  @default(false)
  propertyId        Int      @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  property          Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}
