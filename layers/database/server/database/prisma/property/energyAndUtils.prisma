model EnergyAndUtilities {
  id                   Int                  @id @default(autoincrement())
  propertyId           Int                  @unique
  epcRating            EPCRating?
  epcCertificateUrl    String?
  primaryHeatingType   HeatingType[]
  secondaryHeatingType HeatingType[]
  boilerType           BoilerType?
  hotWaterSource       HotWaterSource?
  renewables           RenewableEnergy[]
  // This will get pulled from an API of property creation
  connectedUtilities   ConnectedUtilities[]
  broadbandType        BroadbandType?
  fullFibreAvailable   Boolean              @default(false)
  maxDownloadSpeedMbps Float?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  property             Property             @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
}

enum EPCRating {
  A
  B
  C
  D
  E
  F
  G
  UNKNOWN
}

enum HeatingType {
  GAS_CENTRAL
  ELECTRIC
  OIL
  UNDERFLOOR
  BIOMASS
  HEAT_PUMP
  DISTRICT
  STORAGE_HEATERS
  LPG
  PASSIVE
  SOLAR_THERMAL
  OTHER
}

enum BoilerType {
  COMBI
  SYSTEM
  CONVENTIONAL
  BACK_BOILER
  UNKNOWN
}

enum HotWaterSource {
  BOILER
  IMMERSION_HEATER
  SOLAR_THERMAL
  HEAT_PUMP
  OTHER
}

enum RenewableEnergy {
  SOLAR_PV
  BATTERY_STORAGE
  SMART_METER
  EV_CHARGING
  GREY_WATER
}

enum ConnectedUtilities {
  GAS
  ELECTRICITY
  WATER
  SEWAGE
  DRAINAGE
  SEPTIC_TANK
  CESSPIT
  RAINWATER_HARVESTING
}

enum BroadbandType {
  ADSL
  FTTC
  FTTP
  CABLE
  MOBILE
  UNKNOWN
}
