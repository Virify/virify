model EnergyAndUtilities {
  id                        Int             @id @default(autoincrement())
  propertyId                Int             @unique
  epcRating                 EPCRating?
  epcCertificateUrl         String?
  primaryHeatingType        HeatingType?
  secondaryHeatingType      HeatingType?
  boilerType                BoilerType?
  hotWaterSource            HotWaterSource?
  solarPanels               Boolean         @default(false)
  batteryStorage            Boolean         @default(false)
  smartMeterInstalled       Boolean         @default(false)
  evChargingPointInstalled  Boolean         @default(false)
  // This will get pulled from an API of property creation
  broadbandType             BroadbandType?
  fullFibreAvailable        Boolean         @default(false)
  maxDownloadSpeedMbps      Float?
  mainsGas                  Boolean         @default(false)
  mainsElectricity          Boolean         @default(false)
  mainsWater                Boolean         @default(false)
  privateWaterSupply        Boolean         @default(false)
  mainsDrainage             Boolean         @default(false)
  septicTank                Boolean         @default(false)
  cesspool                  Boolean         @default(false)
  rainwaterHarvestingSystem Boolean         @default(false)
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  property                  Property        @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
}

enum EPCRating {
  A
  B
  C
  D
  E
  F
  G
  UNKNOWN
}

enum HeatingType {
  GAS_CENTRAL
  ELECTRIC
  OIL
  UNDERFLOOR
  BIOMASS
  HEAT_PUMP
  DISTRICT
  STORAGE_HEATERS
  OTHER
}

enum BoilerType {
  COMBI
  SYSTEM
  CONVENTIONAL
  BACK_BOILER
  UNKNOWN
}

enum HotWaterSource {
  BOILER
  IMMERSION_HEATER
  SOLAR_THERMAL
  HEAT_PUMP
  OTHER
}

enum BroadbandType {
  ADSL
  FTTC
  FTTP
  CABLE
  MOBILE
  UNKNOWN
}
