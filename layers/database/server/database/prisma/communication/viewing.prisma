model Viewing {
  id                Int           @id @default(autoincrement())
  listingId         Int
  requesterId       Int
  ownerId           Int
  conversationId    Int?
  proposedDates     DateTime[]
  preferredTimes    String[]
  counterProposedAt DateTime?
  lastProposedBy    String?       @default("requester")
  status            ViewingStatus @default(PENDING)
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  listing      Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  requester    User          @relation("ViewingRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  owner        User          @relation("ViewingAsOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@index([requesterId])
  @@index([ownerId])
  @@index([conversationId])
  @@index([status])
}

enum ViewingStatus {
  PENDING
  ACCEPTED
  REJECTED
  RESCHEDULED
  CANCELLED
}
