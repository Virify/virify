model Conversation {
  id         Int       @id @default(autoincrement())
  listingId  Int?
  senderId   Int
  receiverId Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  messages   Message[]
  sender     User      @relation("ConversationsAsSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User      @relation("ConversationsAsReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  listing    Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([listingId])
  @@index([createdAt])
}
