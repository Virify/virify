model Address {
  id         Int                      @id @default(autoincrement())
  number     String?
  flat       String?
  street     String?
  city       String?
  postcode   String?
  country    String?
  county     String?
  propertyId Int?                     @unique
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  // geolocation fields
  location   Unsupported("geometry")?
  property   Property?

  @@unique([street, city, postcode, country])
  @@index([location], map: "address_location_idx", type: Gist)
  @@index([postcode], map: "address_postcode_idx")
  @@index([city], map: "address_city_idx")
  @@index([street], map: "address_street_idx")
}
