model UserOwnership {
  id                         Int           @id @default(autoincrement())
  verificationId             Int?
  verification               Verification? @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  pendingOwnershipDocuments  String[]
  approvedOwnershipDocuments String[]
  deniedOwnershipDocuments   String[]
  rejectReason               String?
  reviewed                   Reviewed      @default(PENDING)
  draftListingId             Int?          @unique
  draftListing               DraftListing? @relation(fields: [draftListingId], references: [id], onDelete: Cascade)
  listingId                  Int?          @unique
  listing                    Listing?      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
}
