// User Notification Model
// Stores independent notifications for users
// Decoupled from conversation fetching for efficient notification delivery

model UserNotification {
  id     Int  @id @default(autoincrement())
  userId Int // The user who receives the notification
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Notification type for categorization and filtering
  type NotificationType

  // Display data - minimal info needed to render the notification
  title          String // e.g., "New message from Jamie"
  message        String // e.g., "Hi, I'm interested in your property..."
  senderUsername String? // Username of the person who triggered the notification
  senderAvatar   String? // Avatar URL for display

  // Reference IDs for navigation - stored separately so we don't need to fetch relations
  conversationId Int? // Optional: if related to a conversation
  listingId      Int? // Optional: if related to a listing
  messageId      Int? // Optional: if related to a specific message

  // Minimal listing data for display (denormalized for performance)
  // Only populated if the notification is related to a listing
  listingPrice    Int? // Listing price for display
  listingAddress  String? // Short address for display
  listingImage    String? // Primary image URL
  listingIsRental Boolean? // Sale or rent indicator

  // Status tracking
  isRead      Boolean @default(false)
  isDismissed Boolean @default(false)

  // Timestamps
  createdAt DateTime  @default(now())
  readAt    DateTime? // When the notification was read

  @@index([userId])
  @@index([userId, isRead])
  @@index([conversationId])
  @@index([createdAt])
}

enum NotificationType {
  NEW_MESSAGE // New message in existing conversation
  NEW_ENQUIRY // New enquiry/conversation started
  ENQUIRY_REPLY // Reply to an enquiry the user sent
  LISTING_UPDATE // Updates about user's listings (views, etc.)
  SYSTEM // System notifications
  VIEWING_REQUEST // Viewing request received
  VIEWING_ACCEPTED // Viewing request accepted by owner
  VIEWING_REJECTED // Viewing request rejected by owner
  VIEWING_RESCHEDULED // Viewing time proposed to change
  VIEWING_CANCELLED // Viewing cancelled by either party
}
