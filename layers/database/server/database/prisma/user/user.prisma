model User {
  id                       Int                   @id @default(autoincrement())
  firstName                String?
  lastName                 String?
  username                 String?               @unique
  avatar                   String?
  bio                      String?
  intents                  UserIntent[]
  interests                String[]
  email                    String                @unique
  phoneNumber              String?
  password                 String?
  passwordResetToken       String?               @unique
  passwordResetTokenExpiry DateTime?
  otpCode                  String?
  otpCodeExpiry            DateTime?
  lastLogin                DateTime?
  deletedAt                DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  listings                 Listing[]
  properties               Property[]
  verification             Verification?
  preferences              UserPreferences[]
  notifications            UserNotification[]
  address                  Address?              @relation(fields: [addressId], references: [id])
  addressId                Int?
  ListingView              ListingView[]
  messagesSent             Message[]             @relation("SenderMessages")
  messagesReceived         Message[]             @relation("ReceiverMessages")
  conversationsAsSender    Conversation[]        @relation("ConversationsAsSender")
  conversationsAsReceiver  Conversation[]        @relation("ConversationsAsReceiver")
  userMedia                UserMedia[]
  membership               Membership?
  DraftListing             DraftListing[]
  mortgageCalculations     MortgageCalculation[]
  // Analytics relations
  ListingImpression        ListingImpression[]
  DailyListingStats        DailyListingStats[]
  DailyUserStats           DailyUserStats[]
  ListingClick             ListingClick[]
  ListingShare             ListingShare[]

  @@index([addressId])
  @@index([email])
  @@index([username])
}

enum UserIntent {
  BUYING
  SELLING
  RENTING
  LANDLORD
}
