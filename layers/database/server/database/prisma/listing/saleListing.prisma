model SaleListing {
  id                 Int                    @id @default(autoincrement())
  listing            Listing?               @relation(fields: [listingId], references: [id])
  listingId          Int?                   @unique
  tenureType         TenureType?
  chain              Boolean                @default(false)
  sharedOwnership    Boolean                @default(false)
  priceType          SalePriceType?
  availabilityStatus SaleAvailabilityStatus
  DraftListing       DraftListing?          @relation(fields: [draftListingId], references: [id], onDelete: Cascade)
  draftListingId     Int?                   @unique

  @@index([listingId])
  @@index([draftListingId])
}

enum TenureType {
  FREEHOLD
  LEASEHOLD
  COMMONHOLD
}

enum SalePriceType {
  FIXED
  OFFERS_OVER
  GUIDE_PRICE
}

enum SaleAvailabilityStatus {
  AVAILABLE
  UNDER_OFFER
  SOLD
}
