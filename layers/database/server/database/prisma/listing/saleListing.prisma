model SaleListing {
  id                 Int                    @id
  listing            Listing                @relation(fields: [id], references: [id])
  tenureType         TenureType?
  chain              Boolean                @default(false)
  sharedOwnership    Boolean                @default(false)
  priceType          SalePriceType?
  availabilityStatus SaleAvailabilityStatus
  DraftListing       DraftListing[]

  @@index([id])
}

enum TenureType {
  FREEHOLD
  LEASEHOLD
  COMMONHOLD
}

enum SalePriceType {
  FIXED
  OFFERS_OVER
  GUIDE_PRICE
}

enum SaleAvailabilityStatus {
  AVAILABLE
  UNDER_OFFER
  SOLD
}
