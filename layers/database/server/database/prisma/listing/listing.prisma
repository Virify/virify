model Listing {
  id                   Int                    @id @default(autoincrement())
  price                Float
  moveInDate           DateTime?
  listingTier          ListingTier
  listingStartDate     DateTime?
  listingEndDate       DateTime?
  viewingOptions       String?
  ownershipVerified    Boolean                @default(false)
  rentalListing        RentalListing?
  saleListing          SaleListing?
  userId               Int?
  propertyId           Int
  publishedAt          DateTime?
  published            Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  user                 User?                  @relation(fields: [userId], references: [id])
  property             Property?              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  HiddenListing        HiddenListing[]
  UserFavouriteListing UserFavouriteListing[]
  ListingView          ListingView[]
  conversations        Conversation[]
  UserNote             UserNote[]
  archived             Boolean                @default(false)
  archivedAt           DateTime?
  // Analytics relations
  ListingImpression    ListingImpression[]
  ListingPriceHistory  ListingPriceHistory[]
  DailyListingStats    DailyListingStats[]
  ListingClick         ListingClick[]
  ListingShare         ListingShare[]
  viewings             Viewing[]

  @@index([userId])
  @@index([propertyId])
  @@index([price])
  @@index([publishedAt])
}

enum ListingTier {
  BASIC
  PREMIUM
  FEATURED
}
