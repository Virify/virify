model Listing {
  id                 Int                @id @default(autoincrement())
  title              String
  description        String
  price              Float?
  priceType          PriceType?
  listingType        ListingType
  listingCategory    ListingCategory
  availabilityStatus AvailabilityStatus
  moveInDate         DateTime?
  listingTier        ListingTier
  listingStartDate   DateTime?
  listingEndDate     DateTime?
  contactMethod      ContactMethod[]
  viewingOptions     String? 
  verificationLevel  VerificationLevel?
  userId             Int?
  propertyId         Int?               @unique
  estateAgentId      Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user         User?         @relation(fields: [userId], references: [id])
  property     Property?     @relation(fields: [propertyId], references: [id])
  estateAgent  EstateAgent?  @relation(fields: [estateAgentId], references: [id])
  listingCosts ListingCosts?
  agents       Agent[]       @relation("AgentToListing")

  @@index([userId])
  @@index([propertyId])
}

enum ListingType {
  FOR_SALE
  RENT_SHORT
  RENT_LONG
  RENT_TO_BUY
  SHORT_TERM_LET
  AUCTION
}

enum ListingTier {
  BASIC
  PREMIUM
  FEATURED
}

enum AvailabilityStatus {
  AVAILABLE
  UNDER_OFFER
  SOLD
  LET_AGREED
}

enum ListingCategory {
  SALE
  RENTAL
}

enum PriceType {
  OFFERS_IN_EXCESS_OF
  GUIDE_PRICE
  OFFERS_IN_THE_REGION_OF
  ASKING_PRICE
  PER_CALENDAR_MONTH
  PER_WEEK
}

enum ContactMethod {
  CALL
  EMAIL
  WHATSAPP
  LIVE_CHAT
}

enum VerificationLevel {
  UNVERIFIED
  BASIC
  VERIFIED
  FULLY_VERIFIED
}
