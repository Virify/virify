model RentalListing {
  id                 Int                      @id @default(autoincrement())
  listing            Listing?                 @relation(fields: [listingId], references: [id])
  listingId          Int?                     @unique
  deposit            Float?
  holdingDeposit     Float?
  rentFrequency      RentalPriceType?
  isBillsIncluded    Boolean
  rentalLength       RentalLengthType?
  furnishedStatus    FurnishedStatus?
  availabilityStatus RentalAvailabilityStatus @default(AVAILABLE)
  DraftListing       DraftListing?            @relation(fields: [draftListingId], references: [id], onDelete: Cascade)
  draftListingId     Int?                     @unique

  @@index([listingId])
  @@index([draftListingId])
}


enum FurnishedStatus {
  FURNISHED
  UNFURNISHED
  PART_FURNISHED
}


enum RentalPriceType {
  WEEKLY
  MONTHLY
}


enum RentalAvailabilityStatus {
  AVAILABLE
  LET_AGREED
  LET
}

enum RentalLengthType {
  SHORT_TERM
  LONG_TERM
}
