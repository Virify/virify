model RentalListing {
  id                 Int                      @id @default(autoincrement())
  listing            Listing?                 @relation(fields: [listingId], references: [id])
  listingId          Int?                     @unique
  deposit            Float?
  holdingDeposit     Float?
  rentFrequency      RentalPriceType?
  isBillsIncluded    Boolean
  rentalLength       Int?
  furnishedStatus    FurnishedStatus?
  availabilityStatus RentalAvailabilityStatus
  DraftListing       DraftListing?            @relation(fields: [draftListingId], references: [id])
  draftListingId     Int?                     @unique

  @@index([listingId])
  @@index([draftListingId])
}

enum FurnishedStatus {
  FURNISHED
  UNFURNISHED
  PART_FURNISHED
}

enum RentalPriceType {
  WEEKLY
  MONTHLY
}

enum RentalAvailabilityStatus {
  AVAILABLE
  LET_AGREED
  LET
}
