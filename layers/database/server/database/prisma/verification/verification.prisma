model Verification {
  id                    Int          @id @default(autoincrement())
  userId                Int?         @unique
  estateAgentId         Int?         @unique
  identity              Boolean?
  address               Boolean?
  bank                  Boolean?
  payslip               Boolean?
  business              Boolean?
  reviewed              Reviewed     @default(PENDING)
  reviewToken           String?      @unique
  reviewTokenExpiry     DateTime?
  activated             Boolean      @default(false)
  activationToken       String?      @unique
  activationTokenExpiry DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  user                  User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  EstateAgent           EstateAgent? @relation(fields: [estateAgentId], references: [id], onDelete: Cascade)
}

enum Reviewed {
  PENDING
  APPROVED
  REJECTED
}
