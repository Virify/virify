model Verification {
  id                    Int              @id @default(autoincrement())
  userId                Int?             @unique
  estateAgentId         Int?             @unique
  identity              Boolean?
  address               Boolean?
  bank                  Boolean?
  payslip               Boolean?
  role                  Role             @default(USER)
  reviewed              Reviewed         @default(PENDING)
  reviewToken           String?          @unique
  reviewTokenExpiry     DateTime?
  activated             ActivationStatus @default(PENDING)
  activationToken       String?          @unique
  activationTokenExpiry DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  user                  User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  EstateAgent           EstateAgent?     @relation(fields: [estateAgentId], references: [id], onDelete: Cascade)
}

enum ActivationStatus {
  PENDING
  UNVERIFIED
  ACTIVATED
  EXPIRED
  DENIED
}

enum Reviewed {
  PENDING
  APPROVED
  REJECTED
}

enum Role {
  USER
  BUSINESS
  ADMIN
}
