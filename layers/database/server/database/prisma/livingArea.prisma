model LivingArea {
  id          Int      @id @default(autoincrement())
  roomNumber  Int      @default(1)
  fireplace   Boolean
  balcony     Boolean
  openConcept Boolean
  description String
  size        Float?
  propertyId  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  property    Property @relation(fields: [propertyId], references: [id])
}
