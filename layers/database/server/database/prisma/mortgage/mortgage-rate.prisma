model MortgageRate {
  id         Int                @id @default(autoincrement())
  rateType   MortgageRateType
  buyerType  MortgageBuyerType
  ltvBracket MortgageLtvBracket
  rate       Float // Average rate as percentage (e.g., 4.5 for 4.5%)
  fetchedAt  DateTime           @default(now())
  validFrom  DateTime           @default(now())
  validUntil DateTime? // NULL means current/latest rate
  source     String             @default("GPT-4o-mini UK Average")
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([rateType, buyerType, ltvBracket, validUntil])
  @@index([rateType, buyerType, ltvBracket])
  @@index([fetchedAt])
  @@index([validUntil])
}

enum MortgageRateType {
  FIXED_2_YEAR
  FIXED_3_YEAR
  FIXED_5_YEAR
  FIXED_10_YEAR
  VARIABLE
  TRACKER
}

enum MortgageBuyerType {
  FIRST_TIME_BUYER
  HOME_MOVER
  BUY_TO_LET
  REMORTGAGE
}

enum MortgageLtvBracket {
  LTV_60 // Up to 60% LTV
  LTV_75 // 60-75% LTV
  LTV_85 // 75-85% LTV
  LTV_90 // 85-90% LTV
  LTV_95 // 90-95% LTV
}
