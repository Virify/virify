model MortgageCalculation {
  id        Int     @id @default(autoincrement())
  userId    Int? // Optional - only if logged in
  listingId String? // Optional - only if pre-populated from listing
  sessionId String? // Anonymous session tracking

  // Input data
  propertyPrice Float
  deposit       Float
  termYears     Float // Supports decimal for months
  buyerType     MortgageBuyerType
  customRate    Float? // User-provided rate if any

  // Calculated data
  loanAmount Float
  ltv        Float
  ltvBracket MortgageLtvBracket

  // Result data (best rate found)
  monthlyPayment Float
  totalPayment   Float
  totalInterest  Float
  rateUsed       Float
  rateType       String // Rate type used (FIXED_2_YEAR, CUSTOM, etc.)

  // Meta
  usedDefaultRates Boolean @default(false)
  usedCustomRate   Boolean @default(false)

  createdAt DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([listingId])
  @@index([buyerType])
  @@index([createdAt])
}
