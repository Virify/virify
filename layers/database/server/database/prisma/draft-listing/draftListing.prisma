model DraftListing {
  id                Int                @id @default(autoincrement())
  title             String
  description       String
  price             Float
  moveInDate        DateTime?
  listingTier       ListingTier
  listingStartDate  DateTime?
  listingEndDate    DateTime?
  viewingOptions    String?
  verificationLevel VerificationLevel?
  rentalListing     RentalListing?     @relation(fields: [rentalListingId], references: [id])
  saleListing       SaleListing?       @relation(fields: [saleListingId], references: [id])
  userId            Int?
  propertyId        Int
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User?              @relation(fields: [userId], references: [id])
  property          Property?          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rentalListingId   Int?
  saleListingId     Int?

  @@index([userId])
  @@index([propertyId])
  @@index([price])
}
