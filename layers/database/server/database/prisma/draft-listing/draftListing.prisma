model DraftListing {
  id                Int                @id @default(autoincrement())
  price             Float?
  moveInDate        DateTime?
  listingTier       ListingTier
  listingStartDate  DateTime?
  listingEndDate    DateTime?
  viewingOptions    String?
  verificationLevel VerificationLevel?
  completedSteps    Int[]              @default([])
  rentalListing     RentalListing?
  saleListing       SaleListing?
  userId            Int
  propertyId        Int?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User?              @relation("DraftListingOwner", fields: [userId], references: [id])
  property          Property?          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sharedUsers       User[]             @relation("DraftListingSharedUsers")
  ownershipVerification OwnershipVerification?

  @@index([userId])
  @@index([propertyId])
  @@index([price])
}
