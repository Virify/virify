/// Pre-aggregated daily stats for fast graph rendering
model DailyListingStats {
  id          Int      @id @default(autoincrement())
  listingId   Int
  userId      Int // Denormalized for fast user-level queries
  date        DateTime @db.Date
  views       Int      @default(0)
  uniqueViews Int      @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0) // Clicks from search results
  favourites  Int      @default(0) // New favourites that day
  enquiries   Int      @default(0) // New enquiries that day
  avgDuration Int? // Average view duration in seconds

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listingId, date])
  @@index([listingId])
  @@index([userId])
  @@index([date])
}
