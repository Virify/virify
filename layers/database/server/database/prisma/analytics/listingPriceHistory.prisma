/// Track price changes over time for market analysis
model ListingPriceHistory {
  id            Int      @id @default(autoincrement())
  listingId     Int
  oldPrice      Float
  newPrice      Float
  changePercent Float // Percentage change for quick analysis
  createdAt     DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([createdAt])
}
