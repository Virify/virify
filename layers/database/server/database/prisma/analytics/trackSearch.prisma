/// Unified search tracking for analytics
/// Tracks each unique combination of location + radius + query
model TrackSearch {
  id        Int      @id @default(autoincrement())
  
  // Location data from MapTiler
  locationPlaceName String   /// e.g. "Cardiff, Wales, United Kingdom"
  locationText      String   /// Short name e.g. "Cardiff"
  locationLat       Float    /// Latitude
  locationLon       Float    /// Longitude
  
  // Search parameters
  radius    Int      /// Search radius in miles (0 = this area only)
  query     String   /// The search prompt/query
  
  // Results tracking
  resultCount Int    @default(0) /// Number of results returned
  
  // User tracking (array of user IDs who performed this search)
  userIds   Int[]    @default([])
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Unique constraint on the search combination
  @@unique([locationPlaceName, radius, query])
  
  // Indexes for common queries
  @@index([locationPlaceName])
  @@index([query])
  @@index([createdAt])
  @@index([resultCount])
}
