/// Unified search tracking for analytics
/// Tracks each unique combination of location + radius + query
model TrackSearch {
  id                Int      @id @default(autoincrement())
  locationId        String   @default("") // MapTiler geocoding ID for re-geocoding
  listingType       ListingType
  locationPlaceName String
  locationText      String
  locationLat       Float
  locationLon       Float
  radius            Int
  query             String
  resultCount       Int      @default(0)
  count             Int      @default(0)
  userIds           Int[]    @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([listingType, locationPlaceName, radius, query])
  @@index([locationPlaceName])
  @@index([query])
  @@index([createdAt])
  @@index([resultCount])
}

enum ListingType {
  SALE
  RENT
  ALL
}