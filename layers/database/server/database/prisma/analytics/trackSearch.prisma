/// Unified search tracking for analytics
/// Tracks each unique combination of location + radius + query
model TrackSearch {
  id                Int         @id @default(autoincrement())
  locationId        String      @default("") // MapTiler geocoding ID for re-geocoding
  searchType        String      @default("ai") // "ai" | "traditional"
  listingType       ListingType
  locationPlaceName String
  locationText      String
  locationLat       Float
  locationLon       Float
  radius            Int
  query             String
  resultCount       Int         @default(0)
  count             Int         @default(0)
  userIds           Int[]       @default([])
  usedTerms         String[]    @default([]) // human-readable labels for active filters (analytics: what people search for)
  ignoredTerms      String[]    @default([]) // terms GPT couldn't map to a filter (analytics: feature gaps)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Impressions generated by this search
  impressions ListingImpression[]

  @@unique([listingType, locationPlaceName, radius, query])
  @@index([locationPlaceName])
  @@index([query])
  @@index([createdAt])
  @@index([resultCount])
}

enum ListingType {
  SALE
  RENT
  ALL
}
