/// Track listing appearances in search results for CTR analysis
model ListingImpression {
  id          Int      @id @default(autoincrement())
  listingId   Int
  userId      Int?
  sessionId   String?
  searchId    Int? // Link to TrackSearch that generated this impression
  position    Int? // Position in search results (1-indexed)
  clicked     Boolean  @default(false)
  source      String? // Traffic source
  searchQuery String? // Search query that generated this impression
  userAgent   String?
  ip          String?
  createdAt   DateTime @default(now())

  listing Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  search  TrackSearch? @relation(fields: [searchId], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@index([userId])
  @@index([searchId])
  @@index([createdAt])
  @@index([clicked])
  @@index([sessionId])
}
