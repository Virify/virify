model ListingView {
  id        Int      @id @default(autoincrement())
  listingId Int
  userId    Int?
  sessionId String?
  ip        String?
  userAgent String? // Device/browser detection
  referrer  String? // Where traffic came from (google, facebook, etc.)
  source    String? // Traffic source type: direct, search, share, email, social
  duration  Int? // Seconds spent viewing (updated via beacon on page leave)
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
  @@index([source])
}
