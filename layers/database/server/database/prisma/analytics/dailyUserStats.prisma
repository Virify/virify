/// Pre-aggregated daily user stats for analytics graphs
model DailyUserStats {
  id                 Int      @id @default(autoincrement())
  userId             Int
  date               DateTime @db.Date
  listingViews       Int      @default(0) // Views on user's listings
  totalImpressions   Int      @default(0) // Impressions on user's listings
  enquiriesReceived  Int      @default(0)
  enquiriesSent      Int      @default(0)
  favouritesReceived Int      @default(0) // Others favouriting user's listings
  searchesPerformed  Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}
